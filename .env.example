# Token from @BotFather
BOT_TOKEN=123456789:replace_me

# Numeric ID of the private channel, usually starts with -100
CHANNEL_ID=-1001234567890

# Monthly price in Telegram Stars (1-10000)
SUBSCRIPTION_PRICE=150

# Telegram user IDs allowed to use /stats and /refresh_link
ADMIN_IDS=123456789

# Username without @
SUPPORT_USERNAME=your_support

# Optional
SUBSCRIPTION_LINK_NAME=Bot subscription
DATABASE_PATH=data/bot.sqlite3
